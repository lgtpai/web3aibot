# 猎狗AI Pharos Skill 环境变量配置

# 【必填】Pharos 收款钱包地址（用于接收用户支付的 PHRS）
LGAI_RECIPIENT_ADDRESS=0xYOUR_WALLET_ADDRESS_HERE

# 【必填】Session token 签名密钥（随机字符串，勿泄露）
LGAI_SECRET=change_this_to_a_random_secret_string

# Pharos 测试网 x402 facilitator（默认值已填，一般无需修改）
PHAROS_FACILITATOR_URL=https://x402.pharos.xyz/facilitator

# 本地调试：设为 true 时跳过链上支付验证
LGAI_DEV_MODE=false
